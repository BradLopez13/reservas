# En desarrollo se trabaja directamente contra la base de datos de Supabase.
# DATABASE_URL: pooler en modo transacción (puerto 6543), el que usa la API.
# DATABASE_URL_DIRECT: pooler en modo sesión (puerto 5432), solo para las migraciones.
DATABASE_URL=postgresql://postgres.<proyecto>:<contraseña>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.<proyecto>:<contraseña>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
RESERVAS_ESTRATEGIA=exclude
